#!/bin/sh /etc/rc.common
# procd init script for cmd/gps-exporter on OpenWrt/WaveOS — pushes GPS
# fixes to InfluxDB's "location" bucket. Install as
# /etc/init.d/gps-exporter: cp this file there, chmod +x, set the real
# values below (or better, edit this copy before installing), then
# `/etc/init.d/gps-exporter enable && /etc/init.d/gps-exporter start`.
#
# Reuses the SAME /opt/dawn/modem-exporter.env token as modem-exporter —
# add-device.sh issues one per-device token scoped to write on all four
# buckets (radio/network/events/location), so no separate token is needed here.
#
# Only useful on modems reached via raw QMI (gps.Supports) — WaveOS's
# ubus "qmi" object doesn't expose real GPS coordinates (its "location"
# method is cell-ID/LAC-CI only, not GNSS). See gps/gps.go's Supports
# doc comment.

START=98
STOP=1
USE_PROCD=1

PROG=/opt/dawn/gps-exporter
ENV_FILE=/opt/dawn/modem-exporter.env

# Per-device identity — adjust per board.
DEVICE_ID=6global
INFLUX_URL=https://wservices.wavesys.pt:8086
INFLUX_ORG=wavecom
INFLUX_BUCKET=location

start_service() {
	INFLUX_TOKEN=""
	[ -f "$ENV_FILE" ] && . "$ENV_FILE"

	procd_open_instance
	procd_set_param command "$PROG" \
		-interval 30s \
		-influx-url "$INFLUX_URL" \
		-influx-org "$INFLUX_ORG" \
		-influx-bucket "$INFLUX_BUCKET" \
		-device-id "$DEVICE_ID"
	procd_set_param env INFLUX_TOKEN="$INFLUX_TOKEN"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
