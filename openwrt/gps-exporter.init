#!/bin/sh /etc/rc.common
# procd init script for cmd/gps-exporter on OpenWrt/WaveOS — pushes GPS
# fixes to InfluxDB's "location" bucket. Install as
# /etc/init.d/gps-exporter: cp this file there, chmod +x, set the real
# values below (or better, edit this copy before installing), then
# `/etc/init.d/gps-exporter enable && /etc/init.d/gps-exporter start`.
#
# Reuses the SAME /opt/dawn/modem-exporter.env token as modem-exporter —
# add-device.sh issues one per-device token scoped to write on all four
# buckets (radio/network/events/location), so no separate token is needed here.
#
# Actually deployed and running on WaveOS via the AT-over-serial backend
# (gps.Supports is true for ModemManager and AT-over-serial; raw QMI is
# implemented but deliberately disabled after repeatedly corrupting
# production QMI client state — see CLAUDE.md's gps/ package section
# and gps/gps.go's Supports doc comment). WaveOS's ubus "qmi" object
# doesn't expose real GPS coordinates either way (its "location" method
# is cell-ID/LAC-CI only, not GNSS), so AT-over-serial is what this
# board actually uses.
#
# -port is pinned by USB vendor/product/interface (usb:<vid>:<pid>:<ifnum>),
# not a ttyUSB number — confirmed live that ttyUSB numbering is not
# stable across a reboot on a board with more than one modem, the same
# reason aaeon's dedicated port got a udev rule instead. The default
# below is the Quectel RM520N-GL's secondary AT port (interface 03) —
# dawn6g/6global's fixed hardware is modem 0 = SIMCom (1e0e:9001),
# modem 1 = Quectel (2c7c:0801); see CLAUDE.md's Project Overview.
# (dawn6g's installed copy still pins -port /dev/ttyUSB10, which is
# the same 2c7c:0801 interface 03 today; this template uses the
# reboot-stable usb: form.)
#
# Fix source: AT only. On the WaveOS Quectel the NMEA reader is parked
# (NMEA streaming on dawn6g is unresolved), so -nmea-port is NOT set
# here. -nmea-port is what aaeon's SIMCom SIM8202G uses (its AT position
# commands never report a fix). Before any -nmea-port use on a Quectel:
# it needs gps-exporter v2.3.2 or later (AT fallback while the NMEA
# stream is stale; v2.3.1's reader can also hang on port setup), and
# the NMEA streaming issue resolved — see the gps-integration skill.
#
# WaveOS itself appends a ubus "platform.events" notify block (marked
# #<pe.1.1>) to every installed init script's start_service; it isn't
# part of this template and needn't be copied.

START=98
STOP=1
USE_PROCD=1

PROG=/opt/dawn/gps-exporter
ENV_FILE=/opt/dawn/modem-exporter.env

# Per-device identity — adjust per board.
# Device ID: none is passed by default, so the exporter tags its data
# with this board's hostname (`uname -n`) — make sure that matches the
# ID provisioned with add-device.sh. To set it explicitly instead,
# uncomment and edit:
# DEVICE_ID=dawn6g
DEVICE_ID=
INFLUX_URL=https://wservices.wavesys.pt:8086
INFLUX_ORG=wavecom
INFLUX_BUCKET=location
GPS_METHOD=at
GPS_PORT=usb:2c7c:0801:03

start_service() {
	INFLUX_TOKEN=""
	[ -f "$ENV_FILE" ] && . "$ENV_FILE"

	procd_open_instance
	procd_set_param command "$PROG" \
		-method "$GPS_METHOD" \
		-port "$GPS_PORT" \
		-interval 30s \
		-influx-url "$INFLUX_URL" \
		-influx-org "$INFLUX_ORG" \
		-influx-bucket "$INFLUX_BUCKET"
	[ -n "$DEVICE_ID" ] && procd_append_param command -device-id "$DEVICE_ID"
	procd_set_param env INFLUX_TOKEN="$INFLUX_TOKEN"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
