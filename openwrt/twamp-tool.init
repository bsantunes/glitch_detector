#!/bin/sh /etc/rc.common
# procd init script for cmd/twamp-tool on OpenWrt/WaveOS (no InfluxDB
# involved — continuous local logging only, readable via `logread`).
# Install as /etc/init.d/twamp-tool: cp this file there, chmod +x, then
# `/etc/init.d/twamp-tool enable && /etc/init.d/twamp-tool start`.
#
# Unlike modem-tool, twamp-tool has no external-tool dependency at all
# (the twamp/ package is a native Go TWAMP-Test sender) — it works here
# precisely because `twampy`/Python is not installable on WaveOS.

START=95
STOP=4
USE_PROCD=1

PROG=/opt/dawn/twamp-tool
REFLECTOR=10.30.30.1:862

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -reflector "$REFLECTOR" -interval 5s
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
