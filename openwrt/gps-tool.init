#!/bin/sh /etc/rc.common
# procd init script for cmd/gps-tool on OpenWrt/WaveOS (no InfluxDB
# involved — continuous local logging only, readable via `logread`).
# Install as /etc/init.d/gps-tool: cp this file there, chmod +x, then
# `/etc/init.d/gps-tool enable && /etc/init.d/gps-tool start`.
#
# Only useful on modems reached via raw QMI (gps.Supports) — WaveOS's
# ubus "qmi" object doesn't expose real GPS coordinates (its "location"
# method is cell-ID/LAC-CI only, not GNSS), so detection falling through
# to ubus before raw QMI means gps-tool finds nothing to poll. See
# gps/gps.go's Supports doc comment.

START=96
STOP=3
USE_PROCD=1

PROG=/opt/dawn/gps-tool

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -interval 10s
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
