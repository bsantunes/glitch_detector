#!/bin/sh /etc/rc.common
# procd init script for cmd/glitch-exporter on OpenWrt/WaveOS — pushes
# stall/retransmission stats to InfluxDB's "network" bucket, via
# AF_PACKET (WaveOS has no clsact/TC-BPF support — see CLAUDE.md's
# glitch-detector-internals skill). Install as /etc/init.d/glitch-exporter:
# cp this file there, chmod +x, set the real values below (or better,
# edit this copy before installing), then
# `/etc/init.d/glitch-exporter enable && /etc/init.d/glitch-exporter start`.
#
# Reuses the SAME /opt/dawn/modem-exporter.env token as modem-exporter —
# add-device.sh issues one per-device token scoped to write on all four
# buckets (radio/network/events/location), so no separate token is needed here.

START=99
STOP=0
USE_PROCD=1

PROG=/opt/dawn/glitch-exporter
ENV_FILE=/opt/dawn/modem-exporter.env

# Per-device identity/target — adjust per board. IFACE must be the
# interface actually carrying live traffic (lte1/mwan1 on dawn6g —
# lte0/mwan0 is disabled, see CLAUDE.md's Current Status).
DEVICE_ID=dawn6g
IFACE=lte1
INFLUX_URL=https://wservices.wavesys.pt:8086
INFLUX_ORG=wavecom
INFLUX_BUCKET=network

start_service() {
	INFLUX_TOKEN=""
	[ -f "$ENV_FILE" ] && . "$ENV_FILE"

	procd_open_instance
	procd_set_param command "$PROG" \
		-iface "$IFACE" \
		-capture afpacket \
		-interval 10s \
		-influx-url "$INFLUX_URL" \
		-influx-org "$INFLUX_ORG" \
		-influx-bucket "$INFLUX_BUCKET" \
		-device-id "$DEVICE_ID"
	procd_set_param env INFLUX_TOKEN="$INFLUX_TOKEN"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	#<pe.1.1>
	ubus call platform.events notify '{"message":"glitch-exporter started","type":"service.start","source":"glitch-exporter","severity":"info","persistent":true}' >/dev/null 2>&1 || true
	#/<pe>
}
