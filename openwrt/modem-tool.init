#!/bin/sh /etc/rc.common
# procd init script for cmd/modem-tool on OpenWrt/WaveOS (no InfluxDB
# involved — continuous local logging only, readable via `logread`).
# Install as /etc/init.d/modem-tool: cp this file there, chmod +x, then
# `/etc/init.d/modem-tool enable && /etc/init.d/modem-tool start`.
#
# See MODEM_TOOL.md for the systemd equivalent (modem-tool.service) and
# general background on running modem-tool as a service.

START=95
STOP=4
USE_PROCD=1

PROG=/opt/dawn/modem-tool

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -interval 30s
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
