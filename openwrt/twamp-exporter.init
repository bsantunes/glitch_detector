#!/bin/sh /etc/rc.common
# procd init script for cmd/twamp-exporter on OpenWrt/WaveOS — pushes
# RTT/jitter/loss to InfluxDB's "network" bucket. Install as
# /etc/init.d/twamp-exporter: cp this file there, chmod +x, set the
# real values below (or better, edit this copy before installing), then
# `/etc/init.d/twamp-exporter enable && /etc/init.d/twamp-exporter start`.
#
# Reuses the SAME /opt/dawn/modem-exporter.env token as modem-exporter —
# add-device.sh issues one per-device token scoped to write on all four
# buckets (radio/network/events/location), so no separate token is needed here.

START=97
STOP=2
USE_PROCD=1

PROG=/opt/dawn/twamp-exporter
ENV_FILE=/opt/dawn/modem-exporter.env

# Per-device identity/target — adjust per board.
DEVICE_ID=6global
REFLECTOR=10.30.30.1:862
INFLUX_URL=https://wservices.wavesys.pt:8086
INFLUX_ORG=wavecom
INFLUX_BUCKET=network

start_service() {
	INFLUX_TOKEN=""
	[ -f "$ENV_FILE" ] && . "$ENV_FILE"

	procd_open_instance
	procd_set_param command "$PROG" \
		-reflector "$REFLECTOR" \
		-interval 30s \
		-influx-url "$INFLUX_URL" \
		-influx-org "$INFLUX_ORG" \
		-influx-bucket "$INFLUX_BUCKET" \
		-device-id "$DEVICE_ID"
	procd_set_param env INFLUX_TOKEN="$INFLUX_TOKEN"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
