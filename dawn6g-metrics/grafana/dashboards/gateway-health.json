          "query": "from(bucket: \"network\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"agent_info\" and r.component == \"glitch-exporter\" and r._field == \"version\" and r.device =~ /^${device:regex}$/)\n  |> group(columns: [\"device\"])\n  |> sort(columns: [\"_time\"])\n  |> elapsed(unit: 1m)\n  |> filter(fn: (r) => r.elapsed < 58)\n  |> map(fn: (r) => ({_time: r._time, text: r.device + \": exporter (re)start, \" + r._value}))",
          "refId": "Anno"
        }
