    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flux"
      },
      "description": "Latest agent_info per device and component over the last 7 days (independent of the time picker). Exporters write it at startup and hourly, so age above 65 min means NOT REPORTING. A component missing from the table has not reported in 7 days. Expected version is set by the dashboard variable.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "MISMATCH": {
                        "color": "orange",
                        "index": 1
                      },
                      "NOT REPORTING": {
                        "color": "red",
                        "index": 2
                      },
                      "OK": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age_min"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "m"
              }
            ]
          }
        ]
