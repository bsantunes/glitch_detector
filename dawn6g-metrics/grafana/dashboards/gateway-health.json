      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "hide": true,
          "query": "latest = (b) => from(bucket: b)\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"agent_info\" and r._field == \"version\" and r.device =~ /^${device:regex}$/)\n  |> last()\n\nunion(tables: [latest(b: \"radio\"), latest(b: \"network\"), latest(b: \"location\")])\n  |> group()\n  |> map(fn: (r) => ({r with age_min: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0}))\n  |> map(fn: (r) => ({\n       device: r.device,\n       component: r.component,\n       version: r._value,\n       last_report: r._time,\n       age_min: r.age_min,\n       status: if r.age_min > 65.0 then \"NOT REPORTING\"\n               else if r._value == \"${expected_version}\" then \"OK\"\n               else \"MISMATCH\"\n     }))\n  |> sort(columns: [\"device\", \"component\"])",
          "refId": "A"
        }
      ],
      "title": "Exporter versions (agent_info, latest per component)",
      "type": "table"
    },
