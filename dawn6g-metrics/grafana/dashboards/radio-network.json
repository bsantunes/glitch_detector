        "name": "Stalls",
        "target": {
          "query": "from(bucket: \"network\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"glitch_event\" and r.device =~ /^${device:regex}$/)\n  |> filter(fn: (r) => r.type == \"stall_end\" and r._field == \"duration_ms\")\n  |> map(fn: (r) => ({\n       _time: time(v: int(v: r._time) - int(v: r._value * 1000000.0)),\n       timeEnd: r._time,\n       text: r.device + \": stall \" + string(v: int(v: r._value)) + \" ms\"\n     }))",
          "refId": "Anno"
        }
      }
    ]
