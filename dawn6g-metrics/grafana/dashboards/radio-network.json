        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "hide": false,
          "query": "gps = from(bucket: \"location\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gps_fix\" and r.device == \"dawn6g\" and r.device =~ /^${device:regex}$/)\n  |> filter(fn: (r) => r._field == \"latitude\" or r._field == \"longitude\")\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n  |> group(columns: [\"device\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"device\", \"latitude\", \"longitude\"])\n\nradio = from(bucket: \"radio\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"radio_cell\" and r.device == \"dawn6g\" and r.device =~ /^${device:regex}$/)\n  |> filter(fn: (r) => r.role == \"anchor\")\n  |> filter(fn: (r) => r._field == \"rsrp\" or r._field == \"sinr\")\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])\n  |> pivot(rowKey: [\"_time\", \"rat\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"device\", \"rat\", \"rsrp\", \"sinr\"])\n\njoin(tables: {gps: gps, radio: radio}, on: [\"_time\", \"device\"])\n  |> group()\n  |> sort(columns: [\"_time\"])",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "hide": false,
          "query": "gps = from(bucket: \"location\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gps_fix\" and r.device == \"6global\" and r.device =~ /^${device:regex}$/)\n  |> filter(fn: (r) => r._field == \"latitude\" or r._field == \"longitude\")\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n  |> group(columns: [\"device\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"device\", \"latitude\", \"longitude\"])\n\nradio = from(bucket: \"radio\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"radio_cell\" and r.device == \"6global\" and r.device =~ /^${device:regex}$/)\n  |> filter(fn: (r) => r.role == \"anchor\")\n  |> filter(fn: (r) => r._field == \"rsrp\" or r._field == \"sinr\")\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])\n  |> pivot(rowKey: [\"_time\", \"rat\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"device\", \"rat\", \"rsrp\", \"sinr\"])\n\njoin(tables: {gps: gps, radio: radio}, on: [\"_time\", \"device\"])\n  |> group()\n  |> sort(columns: [\"_time\"])",
          "refId": "B"
        }
