# Non-secret settings. Secrets live in ./secrets (see gen-secrets.sh).
DOMAIN=wservices.wavesys.pt

INFLUX_ORG=wavecom
INFLUX_ADMIN_USER=admin
GRAFANA_ADMIN_USER=admin

# Bucket retention (InfluxDB duration syntax)
RETENTION_RADIO=90d              # periodic RadioSample KPIs
RETENTION_NETWORK=90d            # TWAMP, QoS/HTB, nDPI, eBPF micro-interruptions
RETENTION_EVENTS=365d            # RadioEvent: PLMN/PCI/TAC change, EN-DC add/drop, RRC re-est.
RETENTION_LOCATION=365d           # device GPS/GNSS position (gps_fix)

# Image pins (bump deliberately)
INFLUXDB_VERSION=2.7
GRAFANA_VERSION=12.0.0
